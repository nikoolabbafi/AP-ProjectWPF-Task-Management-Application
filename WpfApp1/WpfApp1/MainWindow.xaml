<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="ToDo List" Height="600" Width="1000" Background="#f0f0f0">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="ToDo List"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#4caf50"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <Button Content="Add Task"
                    Width="100"
                    HorizontalAlignment="Center"
                    Click="AddButton_Click" />

            <ListBox Margin="10" ItemsSource="{Binding MyTasks}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" Margin="5" Padding="5" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          Click="CheckBox_Click"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="Black"
                                         FontSize="16"/>

                                <TextBox Grid.Column="2"
                                         Text="{Binding ListName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="Black"
                                         FontSize="16"/>

                                <CheckBox Grid.Column="3"
                                          IsChecked="{Binding Starred, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Content="Starred"
                                          VerticalAlignment="Center"
                                          Margin="10,0,0,0"
                                          Click="CheckBox_Click"/>

                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Content="Edit"
                                            Width="50"
                                            Click="EditButton_Click"
                                            Margin="10,0,0,0" />

                                    <Button Content="Delete"
                                            Width="60"
                                            Click="DeleteButton_Click"
                                            Margin="10,0,0,0"
                                            Background="#f44336"
                                            BorderBrush="#d32f2f"/>

                                    <Button Content="Edit List"
                                            Width="70"
                                            Click="EditListButton_Click"
                                            Margin="10,0,0,0"
                                            Background="#ff9800"
                                            BorderBrush="#ef6c00"/>

                                    <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Window>
